# Supabase project settings (Project Settings → API in the Supabase dashboard).
# Use the anon public key ONLY — it is scoped by Row Level Security.
# Never place the service-role key here; it bypasses RLS and must stay server-side.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
